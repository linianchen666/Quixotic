# Quixotic runs locally with no cloud configuration.
# To use your own relay and Clerk application, copy this file to .env and
# supply your own public client settings. Keep server secrets on the relay.
# See docs/operations/02_connect-setup.md.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=
# T3CODE_HOSTED_APP_URL=

# Optional macOS passkey signing settings for your own Apple account.
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=
