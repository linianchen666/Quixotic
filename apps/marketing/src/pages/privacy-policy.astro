---
import Layout from "../layouts/Layout.astro";
import { REPOSITORY_URL } from "../lib/site";
---
<Layout title="Privacy | Quixotic" description="How a local Quixotic installation handles app data.">
  <h1>Privacy</h1>
  <p>Quixotic stores app data on the host machine and runs without product usage reporting. Coding agents can send prompts and context to the providers you select. Optional integrations and telemetry exporters use the services you configure.</p>
  <p><a href={REPOSITORY_URL + "#privacy--telemetry"}>Privacy and telemetry notes</a></p>
</Layout>
