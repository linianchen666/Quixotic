---
import Layout from "../../layouts/Layout.astro";
import { messagesFor } from "../../i18n";
import { localeStaticPaths } from "../../i18n/locales";
import { INSTALL_GUIDE_URL } from "../../lib/site";
import { RELEASES_URL } from "../../lib/releases";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = messagesFor(locale);
const platforms = [
  { id: "mac", name: "macOS", assets: ["arm64.dmg", "x64.dmg"] },
  { id: "win", name: "Windows", assets: ["x64.exe", "arm64.exe"] },
  { id: "linux", name: "Linux", assets: ["x86_64.AppImage", "arm64.AppImage", "amd64.deb", "arm64.deb"] },
] as const;
---

<Layout title={t.downloadHeading} description={t.description} locale={locale} localizedPath="/download">
  <h1>{t.downloadHeading}</h1>
  <div class="actions" aria-label={t.channelLabel}>
    <button type="button" data-channel="stable" aria-pressed="true">{t.stable}</button>
    <button type="button" data-channel="nightly" aria-pressed="false">{t.nightly}</button>
  </div>
  <p><a id="release-link" href={RELEASES_URL} data-fallback={t.releasesPage}>{t.releasesPage}</a></p>
  {platforms.map(({ id, name, assets }) => (
    <section id={id}>
      <h2>{name}</h2>
      <div class="actions">
        {assets.map((asset) => <a data-asset={asset} href={RELEASES_URL}>{asset}</a>)}
      </div>
    </section>
  ))}
  <section id="mobile">
    <h2>{t.mobile}</h2>
    <a href={INSTALL_GUIDE_URL + "#mobile"}>{t.sourceBuilds}</a>
  </section>
  <p><a href={INSTALL_GUIDE_URL}>{t.sourceBuilds}</a></p>
</Layout>

<script>
  import { fetchLatestRelease, NIGHTLY_RELEASES_URL, RELEASES_URL, type ReleaseChannel } from "../../lib/releases";

  const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-channel]");
  const cards = document.querySelectorAll<HTMLAnchorElement>("a[data-asset]");
  const releaseLink = document.querySelector<HTMLAnchorElement>("#release-link")!;
  let channelRequest = 0;

  async function load(channel: ReleaseChannel) {
    const request = ++channelRequest;
    const fallback = channel === "nightly" ? NIGHTLY_RELEASES_URL : RELEASES_URL;
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.channel === channel)));
    releaseLink.href = fallback;
    releaseLink.textContent = releaseLink.dataset.fallback!;
    cards.forEach((card) => { card.href = fallback; });
    try {
      const release = await fetchLatestRelease(channel);
      if (request !== channelRequest) return;
      releaseLink.href = release.html_url;
      releaseLink.textContent = release.tag_name;
      cards.forEach((card) => {
        const match = release.assets.find((asset) => /^Quixotic[-_]/i.test(asset.name) && asset.name.endsWith(`-${card.dataset.asset}`));
        card.href = match?.browser_download_url ?? fallback;
      });
    } catch {
      // The release index is available even when the API cannot load an asset.
    }
  }

  buttons.forEach((button) => button.addEventListener("click", () => {
    const channel = button.dataset.channel === "nightly" ? "nightly" : "stable";
    const url = new URL(location.href);
    if (channel === "nightly") url.searchParams.set("channel", channel);
    else url.searchParams.delete("channel");
    history.replaceState(null, "", url);
    void load(channel);
  }));
  void load(new URLSearchParams(location.search).get("channel") === "nightly" ? "nightly" : "stable");
</script>
