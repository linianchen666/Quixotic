---
import Layout from "../../layouts/Layout.astro";
import { messagesFor } from "../../i18n";
import { localeStaticPaths, localizedHref } from "../../i18n/locales";
import { INSTALL_GUIDE_URL, REPOSITORY_URL } from "../../lib/site";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = messagesFor(locale);
const download = localizedHref(locale, "/download");
---

<Layout title={`Quixotic | ${t.title}`} description={t.description} locale={locale} localizedPath="/">
  <h1>{t.title}</h1>
  <p>{t.description}</p>
  <div class="actions">
    <a id="platform-download" href={download} data-mac={t.platform.mac} data-win={t.platform.win} data-linux={t.platform.linux} data-mobile={INSTALL_GUIDE_URL + "#mobile"} data-mobile-label={t.sourceBuilds}>
      {t.download}
    </a>
    <a href={REPOSITORY_URL}>{t.browseSource}</a>
  </div>
</Layout>

<script>
  import { detectPlatform } from "../../lib/platform";

  const link = document.querySelector<HTMLAnchorElement>("#platform-download");
  const platform = detectPlatform(navigator.userAgent, navigator.maxTouchPoints);
  if (link && platform) {
    if (platform.os === "ios" || platform.os === "android") {
      link.href = link.dataset.mobile!;
      link.textContent = link.dataset.mobileLabel!;
    } else {
      link.textContent = link.dataset[platform.os]!;
      link.hash = platform.os;
    }
  }
</script>
