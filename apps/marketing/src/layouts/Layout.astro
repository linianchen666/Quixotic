---
import "@fontsource-variable/inter";
import { messagesFor } from "../i18n";
import { DEFAULT_LOCALE, LOCALES, localizedHref, type Locale, type LocalizedPath } from "../i18n/locales";
import { REPOSITORY_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  localizedPath?: LocalizedPath;
}

const { title, description, locale = DEFAULT_LOCALE, localizedPath } = Astro.props;
const t = messagesFor(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/quixotic.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {Astro.site && localizedPath && <link rel="alternate" hreflang="x-default" href={new URL(localizedHref(DEFAULT_LOCALE, localizedPath), Astro.site)} />}
    {Astro.site && localizedPath && LOCALES.map(({ code }) => (
      <link rel="alternate" hreflang={code} href={new URL(localizedHref(code, localizedPath), Astro.site)} />
    ))}
  </head>
  <body>
    <header>
      <a class="brand" href={localizedHref(locale, "/")}><img src="/quixotic.svg" alt="" width="32" height="32" />Quixotic</a>
      <nav aria-label="Main">
        <a href={localizedHref(locale, "/download")}>{t.download}</a>
        <a href={REPOSITORY_URL}>GitHub</a>
        <details>
          <summary>{t.language}</summary>
          <ul>
            {LOCALES.map(({ code, name }) => (
              <li><a lang={code} href={localizedHref(code, localizedPath ?? "/")}>{name}</a></li>
            ))}
          </ul>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <nav aria-label={t.terms}>
        <a href="/legal">{t.terms}</a>
        <a href="/privacy-policy">{t.privacy}</a>
        <a href="/security-policy">{t.security}</a>
        <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>MIT</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: "Inter Variable", sans-serif;
    color-scheme: dark;
    color: #f1f5ff;
    background: #0b0f1a;
  }
  * { box-sizing: border-box; }
  body { margin: 0; }
  header, main, footer { width: min(100% - 3rem, 64rem); margin-inline: auto; }
  header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid #293247; }
  .brand, nav { display: flex; gap: 1rem; align-items: center; }
  .brand { color: inherit; text-decoration: none; font-weight: 700; gap: .5rem; }
  nav { flex-wrap: wrap; }
  details { position: relative; }
  summary { cursor: pointer; }
  details ul {
    position: absolute;
    right: 0;
    z-index: 1;
    min-width: max-content;
    margin: .5rem 0;
    padding: .75rem 1rem;
    list-style: none;
    background: #1c2436;
    border: 1px solid #687b9d;
    border-radius: .5rem;
  }
  details li + li { margin-top: .5rem; }
  main { min-height: 66vh; padding-block: clamp(4rem, 12vw, 8rem); }
  h1 { max-width: 15ch; margin: 0 0 1.5rem; font-size: clamp(2.75rem, 8vw, 5.5rem); line-height: 1.05; letter-spacing: -.06em; }
  p { max-width: 44rem; color: #c4cfe0; font-size: 1.1rem; line-height: 1.6; }
  a { color: #bbd3ff; }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
  .actions a { padding: .7rem 1rem; border: 1px solid #687b9d; border-radius: .5rem; text-decoration: none; }
  .actions a:first-child { background: #bbd3ff; border-color: #bbd3ff; color: #0b0f1a; font-weight: 600; }
  footer { border-top: 1px solid #293247; padding-block: 1.5rem; font-size: .875rem; color: #c4cfe0; }
</style>
